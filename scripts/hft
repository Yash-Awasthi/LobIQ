#!/usr/bin/env bash
# One entry point for the toolkit: Nasdaq days (get, replay, backtest, study) and live paper
# trading on the prediction market (live, runs, review). `hft help` lists the commands.
set -euo pipefail

here=$(cd "$(dirname "$(readlink -f "$0")")" && pwd)
root=$(cd "$here/.." && pwd)  # repository, or the unpacked release (bin/, scripts/, config/)
data=${HFT_DATA:-$HOME/data}
reports=${HFT_REPORTS:-$data/reports}

bin=${HFT_BIN:-}
if [ -z "$bin" ]; then
    for c in "$root/bin" "$root/build/native/apps" "$root/build/release/apps"; do
        [ -x "$c/itch_backtest" ] && { bin=$c; break; }
    done
fi

die() { echo "hft: $*" >&2; exit 1; }
need() { [ -n "$bin" ] || die "no built tools: run 'cmake --preset native && cmake --build build/native' or set HFT_BIN"; }
store() {  # S121025, 2025-12-10 or a path -> store directory
    local a=$1
    [ -d "$a" ] && { echo "$a"; return; }
    if [[ $a =~ ^([0-9]{4})-([0-9]{2})-([0-9]{2})$ ]]; then
        a="S${BASH_REMATCH[2]}${BASH_REMATCH[3]}${BASH_REMATCH[1]:2:2}"
    fi
    [ -d "$data/store-$a-v50" ] || die "no store for $1 in $data (hft days lists them, hft get $1 fetches it)"
    echo "$data/store-$a-v50"
}
date_of() { local s=${1##*store-}; echo "20${s:5:2}-${s:1:2}-${s:3:2}"; }
stamp() { date +%Y%m%dT%H%M%S; }

usage() {
    cat <<EOF
hft: low-latency trading toolkit. Data: $data (HFT_DATA). Tools: ${bin:-not built}.

Nasdaq ITCH days (DAY is S121025, 2025-12-10 or a store path):
  hft get DAY...                   download from Nasdaq, verify, build the store
  hft days                         stores on disk, with symbols and size
  hft replay DAY                   rebuild every book of the day, check invariants, time it
  hft strategies                   strategies available to backtest
  hft backtest DAY SYMBOLS STRATEGY [key=value...]
                                   queue-position backtest with an HTML report (SYMBOLS: INTC,AAPL)
  hft study TRAIN[,..] TEST[,..]   microstructure study, out of sample: order flow imbalance, micro-price,
                                   queue position, order lifetimes, trade costs, Hawkes, VPIN
  hft leadlag DAY[,..] [A:B[:-1],..]
                                   how related products follow each other (placebo-checked)

Prediction market, paper only (no order is ever sent):
  hft live [MINUTES] [pm_exec options]
                                   paper market making on the live feed, dashboard on localhost;
                                   after a kill, the next run needs --reset-kill
  hft runs                         past live runs
  hft review RUN                   replay a recorded run and write its HTML report

Other:
  hft demo                         every demo on bundled data, reports in out/
  hft doctor                       tools, data and machine tuning
EOF
}

cmd=${1:-help}
shift || true
case "$cmd" in
help | -h | --help) usage ;;

get)
    [ $# -gt 0 ] || die "usage: hft get DAY..."
    need
    for d in "$@"; do
        [[ $d =~ ^([0-9]{4})-([0-9]{2})-([0-9]{2})$ ]] && d="S${BASH_REMATCH[2]}${BASH_REMATCH[3]}${BASH_REMATCH[1]:2:2}"
        HFT_DATA=$data HFT_INGEST=$bin/ingest HFT_CHECKPOINT=$bin/checkpoint "$root/scripts/ingest_day.sh" "$d-v50.txt.gz"
    done
    ;;

days)
    shopt -s nullglob
    printf "%-10s %-11s %8s %8s\n" day date symbols size
    for s in "$data"/store-S*-v50; do
        n=$(find "$s" -maxdepth 1 -name '*.idx' | wc -l)
        printf "%-10s %-11s %8s %8s\n" "$(basename "$s" | cut -d- -f2)" "$(date_of "$s")" "$n" "$(du -sh "$s" | cut -f1)"
    done
    ;;

replay)
    [ $# -eq 1 ] || die "usage: hft replay DAY"
    need
    s=$(store "$1")
    out=$(mktemp)
    t0=$(date +%s%N)
    rc=0
    THREADS=${THREADS:-$(nproc)} "$bin/book_replay" "$s" tick >"$out" || rc=$?
    t1=$(date +%s%N)
    awk -v t="$(( (t1 - t0) / 1000000 ))e-3" -v day="$(date_of "$s")" 'NR > 1 {m += $3; f += $(NF - 1); n++}
        END {printf "%s: %d symbols, %d messages in %.1f s (%.0fM/s), %d check failures\n", day, n, m, t, m / t / 1e6, f}' "$out"
    rm -f "$out"
    exit $rc
    ;;

strategies)
    need
    { "$bin/itch_backtest" 2>&1 || true; } | sed -n '/^strategies:/,/^venue keys:/p' | sed '$d'  # usage exits 2
    ;;

backtest)
    [ $# -ge 3 ] || die "usage: hft backtest DAY SYMBOLS STRATEGY [key=value...]"
    need
    s=$(store "$1")
    dir="$reports/backtest-$(stamp)"
    "$bin/itch_backtest" "$s" "$2" "$3" "${@:4}" --report "$dir"
    ;;

study)
    [ $# -eq 2 ] || die "usage: hft study TRAIN[,..] TEST[,..]"
    need
    join() { local o= x; for x in ${1//,/ }; do o+="${o:+,}$(store "$x")"; done; echo "$o"; }
    "$bin/itch_study" --train "$(join "$1")" --test "$(join "$2")" --symbols "${SYMBOLS:-30}"
    ;;

leadlag)
    [ $# -ge 1 ] && [ $# -le 2 ] || die "usage: hft leadlag DAY[,..] [A:B[:-1],..]"
    need
    days=
    for x in ${1//,/ }; do days+="${days:+,}$(store "$x")"; done
    exec "$bin/itch_leadlag" "$days" ${2:+"$2"}
    ;;

live)
    need
    minutes=60
    if [[ ${1:-} =~ ^[0-9]+$ ]]; then minutes=$1; shift; fi
    run="$data/live/$(stamp)"  # pm_exec creates it and refuses an existing one
    mkdir -p "$data/live"
    echo "run: $run (Ctrl-C stops; the dashboard's kill switch cancels every paper order)"
    exec "$bin/pm_exec" --paper --run "$run" --config "$root/config/exec.cfg" --seconds $((minutes * 60)) "$@"
    ;;

runs)
    shopt -s nullglob
    printf "%-17s %10s %12s %s\n" run size pnl_usd status
    for r in "$data"/live/*/; do
        r=${r%/}
        pnl=$(awk -F'\t' '$1 == "ledger_pnl_usd" {print $2}' "$r/summary.tsv" 2>/dev/null || true)
        st=$([ -e "$r/KILL" ] && echo killed || { [ -s "$r/summary.tsv" ] && echo done || echo "running or stopped"; })
        printf "%-17s %10s %12s %s\n" "$(basename "$r")" "$(du -sh "$r" | cut -f1)" "${pnl:--}" "$st"
    done
    ;;

review)
    [ $# -eq 1 ] || die "usage: hft review RUN"
    need
    r=$1
    [ -d "$r" ] || r="$data/live/$1"
    [ -d "$r" ] || die "no run $1 (hft runs lists them)"
    "$bin/pm_exec" --replay "$r" --config "$root/config/exec.cfg" --report "$r/report"
    echo "report: $r/report/report.html"
    ;;

demo)
    need
    HFT_BIN=$bin "$root/scripts/demo/all.sh" "${1:-out}"
    ;;

doctor)
    ok() { printf "  %-34s %s\n" "$1" "$2"; }
    echo "tools"
    ok "binaries" "${bin:-missing: build with cmake --preset native}"
    for t in aria2c perf; do ok "$t" "$(command -v $t >/dev/null && echo yes || echo 'no (optional)')"; done
    echo "data ($data)"
    ok "Nasdaq days" "$(find "$data" -maxdepth 1 -name 'store-S*-v50' 2>/dev/null | wc -l)"
    ok "free disk" "$(df -h "$data" 2>/dev/null | awk 'NR == 2 {print $4}')"
    echo "machine (docs/BARE_METAL.md)"
    c=/sys/devices/system/cpu
    ok "isolated CPUs" "$(cat $c/isolated 2>/dev/null || true)"
    ok "governor (cpu0)" "$(cat $c/cpu0/cpufreq/scaling_governor 2>/dev/null || echo n/a)"
    ok "turbo off (stable clock)" "$( [ "$(cat $c/intel_pstate/no_turbo 2>/dev/null)" = 1 ] && echo yes || echo no)"
    ok "transparent huge pages" "$(grep -o '\[[a-z]*\]' /sys/kernel/mm/transparent_hugepage/enabled 2>/dev/null || echo n/a)"
    ok "perf_event_paranoid" "$(cat /proc/sys/kernel/perf_event_paranoid)"
    ;;

*) usage >&2; exit 2 ;;
esac
